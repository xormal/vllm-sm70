// ================================================================================================
// ЧАНКОВЫЙ СКАН GATED-DELTA-NET НА ТЕНЗОРНЫХ ЯДРАХ VOLTA -- ТОЧКА ВХОДА ИЗ PYTHON.
//
// Пять ядер скана (kkt / solve_tril / w,u / h / o) существовали как заголовки и автономные стенды,
// но НЕ БЫЛИ ПОДКЛЮЧЕНЫ: ни одной единицы трансляции их не включало, pybind у них не было, и в
// боевом пути их не стояло вообще -- `import fa2_sm70` давал НОЛЬ GDN-символов. Этот файл -- ровно
// то, чего не хватало: одна единица трансляции, которая их инстанцирует и выдаёт наружу.
//
// ЧТО ЗАМЕНЯЕТСЯ. chunk_gated_delta_rule_fwd из vllm/model_executor/layers/fla/ops/chunk.py:
//     g   = chunk_local_cumsum(g)          <- ОСТАЁТСЯ на Triton (0.195 мс, замена не окупается)
//     A   = chunk_scaled_dot_kkt_fwd(...)  <- volta_gdn_kkt          4.916 -> 0.222 мс
//     A   = solve_tril(A)                  <- volta_gdn_solve_tril   0.622 -> 0.178 мс
//     w,u = recompute_w_u_fwd(...)         <- volta_gdn_chunk_wu     1.133 -> 0.668 мс
//     h,v_new,ht = chunk_..._fwd_h(...)    <- volta_gdn_chunk_h      8.079 -> 1.359 мс
//     o   = chunk_fwd_o(...)               <- volta_gdn_chunk_o     10.193 -> 0.878 мс
// Причина разрыва одна и та же у всех пяти и измерена (volta_prims.h §4qq): Triton при цели sm_70
// НЕ ЭМИТИТ тензорных инструкций вообще -- в PTX mma.sync 0, wmma 0, hmma 0, а tl.dot
// разворачивается в цикл FP32-FMA на обычных ядрах с потолком 3.5 TFLOP/s против 93.6 у HMMA.
//
// ФОРМАТ. Модель идёт в bfloat16, а тензорные ядра Volta bf16 НЕ УМЕЮТ -- значит счёт обязан быть
// fp16, и конверсия здесь СТРУКТУРНА, а не небрежность. Она сделана НАЕЗДНИКОМ на уже существующих
// проходах, а не отдельными ядрами:
//   * выход  -- тип элемента у ядра o -- параметр шаблона (см. volta_gdn_o.cuh): эпилог упаковывает
//               пару из fp32-накопителя одной инструкцией и в fp16, и в bf16. Отдельный проход
//               .to(bfloat16) над [T][H][128] стоил бы 0.378 мс на слой; здесь он стоит НОЛЬ;
//   * вход q,k -- их и так переписывает l2norm, и он в шиме просит выход сразу в fp16;
//   * вход v,beta -- один слитый проход gdn_cast_in (ниже), который читает bf16 и пишет fp16
//               для ОБОИХ разом. Он памяти-ограничен и идёт на полосе копирования.
//
// ЗАЧЕМ ОДНА ФУНКЦИЯ НА ВЕСЬ СКАН, А НЕ ПЯТЬ. Промежуточные A, w, u, h, v_new наружу не нужны
// никому: их единственный потребитель -- следующее ядро той же цепочки. Держать их на стороне
// Python значило бы платить пятью выделениями кэш-аллокатора и пятью пересечениями границы
// расширения на КАЖДЫЙ из 48 слоёв каждого чанк-прохода (это 240 лишних вызовов на заявку).
// Пять отдельных точек входа тоже выведены -- но только для A/B и для стендов.
// ================================================================================================
#include <torch/extension.h>
#include <c10/cuda/CUDAException.h>
#include <c10/cuda/CUDAGuard.h>
#include <ATen/cuda/CUDAContext.h>
#include <cuda_fp16.h>
#include <cuda_bf16.h>

#include "volta_gdn_kkt.cuh"
#include "volta_gdn_rec.cuh"
#include "volta_gdn_tril.cuh"
#include "volta_gdn_wu.cuh"
#include "volta_gdn_h.cuh"
#include "volta_gdn_ho.cuh"
#include "volta_gdn_o.cuh"

namespace {

constexpr int BT = 64;      // чанк. Единственный живой размер у Qwen3.5; ядра на него рассчитаны.
constexpr int DK = 128;     // размерность головы ключа/значения у линейного слоя Qwen3.5
constexpr int DV = 128;

using fa2_sm70::gdn::kDiagRowSmem;

// ------------------------------------------------------------------------------------------------
// СЛИТАЯ КОНВЕРСИЯ ВХОДА. Читает v [T,H,DV] и beta [T,H] в bf16, пишет их же в fp16.
// Один запуск вместо двух: beta вчетверо с лишним меньше v и своим запуском платила бы почти
// целиком за накладной расход запуска (замерено по каталогу декода: 486 из 1448 ядер короче 3 мкс,
// и такие "мелочи" складываются в 1.686 мс зазоров).
// ------------------------------------------------------------------------------------------------
__global__ void gdn_cast_in(const __nv_bfloat16* __restrict__ v, __half* __restrict__ vo,
                            const __nv_bfloat16* __restrict__ b, __half* __restrict__ bo,
                            long nv, long nb) {
  // NB: этот проход СУЩЕСТВУЕТ ТОЛЬКО при bf16-развёртке. Сервер здесь поднимается с
  // --dtype float16, и тогда v/beta приходят уже в fp16 -- ядро не запускается ВООБЩЕ
  // (см. gdn_chunk_scan). Проверять надо развёртку, а не верить постановке: "модель идёт в
  // bfloat16" -- утверждение о конфигурации, и оно у этого сервера ЛОЖНО.
  const long i = (long)blockIdx.x * blockDim.x + threadIdx.x;
  const long stride = (long)gridDim.x * blockDim.x;
  // v идёт ВЕКТОРАМИ ПО 8 (16 Б на конец): [T][H][128] всегда кратно 8 по последней оси.
  for (long j = i; j < nv / 8; j += stride) {
    const uint4 s = reinterpret_cast<const uint4*>(v)[j];
    const __nv_bfloat16* sb = reinterpret_cast<const __nv_bfloat16*>(&s);
    __half t[8];
#pragma unroll
    for (int e = 0; e < 8; ++e) t[e] = __float2half(__bfloat162float(sb[e]));
    reinterpret_cast<uint4*>(vo)[j] = *reinterpret_cast<const uint4*>(t);
  }
  // beta -- скаляр на (позиция, голова), кратности нет; поэлементно.
  for (long j = i; j < nb; j += stride) bo[j] = __float2half(__bfloat162float(b[j]));
}

// Проверка: тензор непрерывен и того типа, что заявлено. Ошибка здесь стоит НЕ падения, а тихо
// неверного ответа (расширение читает чужую раскладку), поэтому проверяется каждый вход.
#define CHK(t, dt, name)                                                            \
  TORCH_CHECK((t).is_cuda() && (t).is_contiguous(), name " must be contiguous CUDA"); \
  TORCH_CHECK((t).scalar_type() == (dt), name " has wrong dtype")

// ------------------------------------------------------------------------------------------------
// Пять отдельных точек входа. Нужны НЕ для боевого пути, а чтобы:
//   * сверять каждый шаг с его трионовским образцом ПООТДЕЛЬНО (иначе расхождение в цепочке из
//     пяти ядер локализуется бисекцией по шагам, а это часы);
//   * мерить шаги по отдельности в одном процессе с чередованием.
// ------------------------------------------------------------------------------------------------

// A[t,h,j] = beta_t * exp(g_t - g_j) * (k_t . k_j), строго нижний треугольник.
torch::Tensor gdn_kkt(torch::Tensor k, torch::Tensor beta, torch::Tensor g,
                      torch::Tensor cu_seqlens, torch::Tensor chunk_indices, int64_t H) {
  const c10::cuda::CUDAGuard guard(k.device());
  CHK(k, torch::kHalf, "k"); CHK(beta, torch::kHalf, "beta"); CHK(g, torch::kFloat, "g");
  const int T = (int)k.size(-3), Hg = (int)k.size(-2);
  TORCH_CHECK(k.size(-1) == DK, "gdn: head_dim must be 128");
  const int NT = (int)chunk_indices.size(0);
  // [ЗАДАЧА 131] Araw живёт в fp16: ядро упирается в ЗАПИСЬ A (96.3 МБ из 128 у fp32-вида),
  // fp16 режет её вдвое; точность пути задаёт округление Ai (см. шапку solve_tril).
  auto A = torch::empty({1, T, (long)H, BT}, torch::dtype(torch::kHalf).device(k.device()));
  const size_t sh = fa2_sm70::gdn::volta_gdn_kkt_smem<BT, DK>();
  // GQ = H/Hg -- параметр ШАБЛОНА: от него зависит размер __shared__ массивов beta/gate и
  // разворот эпилога. Инстанцируются только живые случаи, остальное -- явный отказ, а не
  // тихо неверный ответ.
  auto go = [&](auto tag) {
    constexpr int GQ = decltype(tag)::value;
    auto kern = fa2_sm70::gdn::volta_gdn_kkt<BT, DK, GQ, 2, 4, false, __half>;
    C10_CUDA_CHECK(cudaFuncSetAttribute(kern, cudaFuncAttributeMaxDynamicSharedMemorySize, (int)sh));
    kern<<<dim3(NT, Hg), 256, sh, at::cuda::getCurrentCUDAStream()>>>(
        (const __half*)k.data_ptr(), (const __half*)beta.data_ptr(), g.data_ptr<float>(),
        (__half*)A.data_ptr(), cu_seqlens.data_ptr<int>(), chunk_indices.data_ptr<int>(),
        T, (int)H, Hg);
  };
  const int GQv = (int)H / Hg;
  if (GQv == 1) go(std::integral_constant<int, 1>{});
  else if (GQv == 2) go(std::integral_constant<int, 2>{});
  else if (GQv == 3) go(std::integral_constant<int, 3>{});
  else if (GQv == 4) go(std::integral_constant<int, 4>{});
  else if (GQv == 6) go(std::integral_constant<int, 6>{});
  else if (GQv == 8) go(std::integral_constant<int, 8>{});
  else TORCH_CHECK(false, "gdn_kkt: H/Hg=", GQv, " не инстанцирован");
  C10_CUDA_KERNEL_LAUNCH_CHECK();
  return A;
}

// Ai = (I + A)^{-1}, унитреугольная нижняя, fp16.
torch::Tensor gdn_solve_tril(torch::Tensor A, torch::Tensor cu_seqlens,
                             torch::Tensor chunk_indices) {
  const c10::cuda::CUDAGuard guard(A.device());
  CHK(A, torch::kHalf, "A");        // [ЗАДАЧА 131] Araw теперь fp16 -- парно с gdn_kkt
  const int T = (int)A.size(-3), H = (int)A.size(-2);
  const int NT = (int)chunk_indices.size(0);
  auto Ai = torch::empty({1, T, H, BT}, torch::dtype(torch::kHalf).device(A.device()));
  const size_t sh = fa2_sm70::gdn::volta_gdn_solve_tril_smem<BT, kDiagRowSmem>();
  auto kern = fa2_sm70::gdn::volta_gdn_solve_tril<BT, kDiagRowSmem, __half>;
  C10_CUDA_CHECK(cudaFuncSetAttribute(kern, cudaFuncAttributeMaxDynamicSharedMemorySize, (int)sh));
  kern<<<dim3(NT, H), 128, sh, at::cuda::getCurrentCUDAStream()>>>(
      (const __half*)A.data_ptr(), (__half*)Ai.data_ptr(), chunk_indices.data_ptr<int>(),
      cu_seqlens.data_ptr<int>(), T, H);
  C10_CUDA_KERNEL_LAUNCH_CHECK();
  return Ai;
}

// w = Ai (beta e^g k),  u = Ai (beta v).
std::tuple<torch::Tensor, torch::Tensor> gdn_wu(torch::Tensor k, torch::Tensor v,
                                                torch::Tensor beta, torch::Tensor g,
                                                torch::Tensor Ai, torch::Tensor cu_seqlens,
                                                torch::Tensor chunk_indices) {
  const c10::cuda::CUDAGuard guard(k.device());
  CHK(k, torch::kHalf, "k"); CHK(v, torch::kHalf, "v");
  CHK(beta, torch::kHalf, "beta"); CHK(g, torch::kFloat, "g"); CHK(Ai, torch::kHalf, "Ai");
  const int T = (int)k.size(-3), Hg = (int)k.size(-2), H = (int)v.size(-2);
  const int NT = (int)chunk_indices.size(0);
  auto w = torch::empty({1, T, H, DK}, torch::dtype(torch::kHalf).device(k.device()));
  auto u = torch::empty({1, T, H, DV}, torch::dtype(torch::kHalf).device(k.device()));
  // HPB -- голов значения на блок; обязано ДЕЛИТЬ H/Hg, иначе группа задела бы две головы ключа
  // и общая плитка k стала бы неверной. При GQA=3 это 3, при GQA=1 -- 1.
  const int GQv = H / Hg;
  // [ЗАДАЧА 192] DBUF=1: фаза w пишет вторую копию sA -- её STS уезжают в тень первого
  // умножения (карта солвера: STS +248, LDS -63). Чистый секундомер 19.08: 0.683 -> 0.622 мс
  // (-8.9%) на боевой форме, ответ побитово тот же; SASS-пересъём: T1 упала НИЖЕ канального
  // пола (2979 при ResMII 3352) -- порядок исчерпан. Цена: один блок на SM вместо двух
  // (53 КБ разделяемой), и это уже В ЦЕНЕ замера. Сетка варпов 4x2 -- лучшая точка свипа.
  const size_t sh = fa2_sm70::gdn::volta_gdn_wu_smem<BT, DK, DV, 1>();
  auto go = [&](auto tag) {
    constexpr int HPB = decltype(tag)::value;
    auto kern = fa2_sm70::gdn::volta_gdn_chunk_wu<BT, DK, DV, 4, 2, HPB, 1, true, int, 1>;
    C10_CUDA_CHECK(cudaFuncSetAttribute(kern, cudaFuncAttributeMaxDynamicSharedMemorySize, (int)sh));
    kern<<<dim3(NT, H / HPB), 256, sh, at::cuda::getCurrentCUDAStream()>>>(
        (const __half*)k.data_ptr(), (const __half*)v.data_ptr(), (const __half*)beta.data_ptr(),
        g.data_ptr<float>(), (const __half*)Ai.data_ptr(), (__half*)w.data_ptr(),
        (__half*)u.data_ptr(), cu_seqlens.data_ptr<int>(), chunk_indices.data_ptr<int>(),
        T, H, Hg);
  };
  if (GQv % 3 == 0) go(std::integral_constant<int, 3>{});
  else if (GQv % 2 == 0) go(std::integral_constant<int, 2>{});
  else go(std::integral_constant<int, 1>{});
  C10_CUDA_KERNEL_LAUNCH_CHECK();
  return {w, u};
}

// h [NT,H,DV,DK] -- состояние на НАЧАЛО каждого чанка; v_new; ht -- финальное состояние (fp32).
std::tuple<torch::Tensor, torch::Tensor, torch::Tensor> gdn_h(
    torch::Tensor k, torch::Tensor w, torch::Tensor u, torch::Tensor g,
    c10::optional<torch::Tensor> h0, torch::Tensor cu_seqlens, torch::Tensor chunk_offsets,
    int64_t NT, bool output_final_state) {
  const c10::cuda::CUDAGuard guard(k.device());
  CHK(k, torch::kHalf, "k"); CHK(w, torch::kHalf, "w"); CHK(u, torch::kHalf, "u");
  CHK(g, torch::kFloat, "g");
  // h0 читается ядром как const float*. Тип обязан проверяться ЗДЕСЬ: bf16-буфер, прочитанный
  // как float, даёт не отказ, а тихо неверный ответ -- худший из возможных исходов.
  if (h0.has_value()) { CHK(h0.value(), torch::kFloat, "initial_state"); }
  const int Hg = (int)k.size(-2), H = (int)u.size(-2);
  const int N = (int)cu_seqlens.size(0) - 1;
  auto h = torch::empty({1, (long)NT, H, DV, DK}, torch::dtype(torch::kHalf).device(k.device()));
  auto vn = torch::empty_like(u);
  auto ht = output_final_state
                ? torch::empty({N, H, DV, DK}, torch::dtype(torch::kFloat).device(k.device()))
                : torch::Tensor();
  constexpr int BV = 64;                        // замерено быстрейшим (стенд volta_gdn_h_test)
  const size_t sh = fa2_sm70::gdn::gdn_h_smem<BT, DK, BV>();
  auto kern = fa2_sm70::gdn::volta_gdn_chunk_h<BT, DK, DV, BV, 2, 4, 2, 4, true>;
  C10_CUDA_CHECK(cudaFuncSetAttribute(kern, cudaFuncAttributeMaxDynamicSharedMemorySize, (int)sh));
  kern<<<dim3(DV / BV, N * H), 256, sh, at::cuda::getCurrentCUDAStream()>>>(
      (const __half*)k.data_ptr(), (const __half*)w.data_ptr(), (const __half*)u.data_ptr(),
      g.data_ptr<float>(), h0.has_value() ? h0->data_ptr<float>() : nullptr,
      (__half*)h.data_ptr(), (__half*)vn.data_ptr(),
      output_final_state ? ht.data_ptr<float>() : nullptr,
      cu_seqlens.data_ptr<int>(), chunk_offsets.data_ptr<int>(), H, Hg);
  C10_CUDA_KERNEL_LAUNCH_CHECK();
  return {h, vn, ht};
}

// СЛИТОЕ ТЕЛО: рекуррентность + выход. Плита h НАРУЖУ НЕ ИДЁТ -- выход считается в том же блоке
// из состояния, лежащего в разделяемой. Возвращает {o, ht}. СРЕЗ 1: o содержит только первое
// слагаемое (q h^T с гейтом) -- сверяется отдельно, см. tools/check_ho.py.
// ВТОРОЙ СРЕЗ: если переданы Ai и beta, то w НЕ ЧИТАЕТСЯ, а в u лежит СЫРОЕ v -- пуск gdn_wu
// не нужен вовсе (см. подстановку в шапке volta_gdn_ho.cuh).
std::tuple<torch::Tensor, torch::Tensor> gdn_ho(
    torch::Tensor q, torch::Tensor k, torch::Tensor w, torch::Tensor u, torch::Tensor g,
    c10::optional<torch::Tensor> h0, torch::Tensor cu_seqlens, torch::Tensor chunk_offsets,
    int64_t NT, double scale, bool output_final_state, bool dump_A,
    c10::optional<torch::Tensor> Ai, c10::optional<torch::Tensor> beta) {
  const c10::cuda::CUDAGuard guard(k.device());
  const bool сшито = Ai.has_value() && beta.has_value();
  CHK(q, torch::kHalf, "q"); CHK(k, torch::kHalf, "k"); CHK(w, torch::kHalf, "w");
  CHK(u, torch::kHalf, "u"); CHK(g, torch::kFloat, "g");
  if (сшито) { CHK(Ai.value(), torch::kHalf, "Ai"); CHK(beta.value(), torch::kHalf, "beta"); }
  bool st_half = false;
  if (h0.has_value()) {
    const auto _t = h0->scalar_type();
    TORCH_CHECK(_t == torch::kFloat || _t == torch::kHalf,
                "gdn h+o: initial_state must be fp32/fp16");
    st_half = (_t == torch::kHalf);
  }
  const int T = (int)k.size(-3), Hg = (int)k.size(-2), H = (int)u.size(-2);
  const int N = (int)cu_seqlens.size(0) - 1;
  auto o  = torch::zeros({1, T, H, DV}, torch::dtype(torch::kHalf).device(k.device()));
  auto Ad = dump_A ? torch::zeros({(long)NT, H, BT, BT}, torch::dtype(torch::kHalf).device(k.device()))
                   : torch::Tensor();
  // v_new НАРУЖУ НЕ ИДЁТ: у него нет читателя вне этого тела (mv читает его из разделяемой).
  // Буфер не выделяется вовсе -- это 19.3 МБ на слой при T=4096, которые раньше писались впустую.
  // Тип итогового состояния СОВПАДАЕТ с типом начального: половинная точность здесь задаёт
  // ёмкость контекста в режиме префикс-кэша, и конвертировать на шве нельзя -- это лишний
  // полный проход по HBM на каждый чанк.
  auto ht = output_final_state
                ? torch::empty({N, H, DV, DK},
                               torch::dtype(st_half ? torch::kHalf : torch::kFloat)
                                   .device(k.device()))
                : torch::Tensor();
  constexpr int BV = 64;
  const size_t sh = fa2_sm70::gdn::gdn_ho_smem<BT, DK, BV>();
  auto kern  = fa2_sm70::gdn::volta_gdn_chunk_ho<BT, DK, DV, BV, 2, 4, 2, 4, true, false>;
  auto kernW = fa2_sm70::gdn::volta_gdn_chunk_ho<BT, DK, DV, BV, 2, 4, 2, 4, true, true>;
  auto kernH  = fa2_sm70::gdn::volta_gdn_chunk_ho<BT, DK, DV, BV, 2, 4, 2, 4, true, false, __half>;
  auto kernWH = fa2_sm70::gdn::volta_gdn_chunk_ho<BT, DK, DV, BV, 2, 4, 2, 4, true, true, __half>;
  const void* тело = st_half ? (сшито ? (const void*)kernWH : (const void*)kernH)
                             : (сшито ? (const void*)kernW  : (const void*)kern);
  C10_CUDA_CHECK(cudaFuncSetAttribute(тело, cudaFuncAttributeMaxDynamicSharedMemorySize, (int)sh));
  auto пуск = [&](auto kf, auto тег) {
    using СостТ = typename decltype(тег)::type;
    kf<<<dim3(DV / BV, N * H), 256, sh, at::cuda::getCurrentCUDAStream()>>>(
        (const __half*)k.data_ptr(), сшито ? nullptr : (const __half*)w.data_ptr(),
        (const __half*)u.data_ptr(),
        g.data_ptr<float>(),
        h0.has_value() ? (const СостТ*)h0->data_ptr() : nullptr,
        nullptr, /* v_new наружу не пишется */ nullptr,
        output_final_state ? (СостТ*)ht.data_ptr() : nullptr,
        cu_seqlens.data_ptr<int>(), chunk_offsets.data_ptr<int>(),
        (const __half*)q.data_ptr(), (__half*)o.data_ptr(),
        dump_A ? (__half*)Ad.data_ptr() : nullptr,
        сшито ? (const __half*)Ai->data_ptr() : nullptr,
        сшито ? (const __half*)beta->data_ptr() : nullptr,
        (float)scale, H, Hg);
  };
  struct ТегF { using type = float; };
  struct ТегH { using type = __half; };
  if (st_half) { if (сшито) пуск(kernWH, ТегH{}); else пуск(kernH, ТегH{}); }
  else         { if (сшито) пуск(kernW,  ТегF{}); else пуск(kern,  ТегF{}); }
  C10_CUDA_KERNEL_LAUNCH_CHECK();
  return {o, dump_A ? Ad : ht};
}

// o = scale * ( e^g (q h^T) + tril(e^{g_t-g_s} q k^T) v_new ).
torch::Tensor gdn_o(torch::Tensor q, torch::Tensor k, torch::Tensor v, torch::Tensor h,
                    torch::Tensor g, torch::Tensor cu_seqlens, torch::Tensor chunk_indices,
                    double scale, bool out_bf16) {
  const c10::cuda::CUDAGuard guard(q.device());
  CHK(q, torch::kHalf, "q"); CHK(k, torch::kHalf, "k"); CHK(v, torch::kHalf, "v");
  CHK(h, torch::kHalf, "h"); CHK(g, torch::kFloat, "g");
  const int T = (int)q.size(-3), Hg = (int)q.size(-2), H = (int)v.size(-2);
  const int NT = (int)chunk_indices.size(0);
  auto o = torch::empty({1, T, H, DV},
                        torch::dtype(out_bf16 ? torch::kBFloat16 : torch::kHalf).device(q.device()));
  const size_t sh = fa2_sm70::gdn::gdn_smem_bytes<BT, DK, DV>();
  auto st = at::cuda::getCurrentCUDAStream();
  if (out_bf16) {
    auto kern = fa2_sm70::gdn::volta_gdn_chunk_o<BT, DK, DV, 2, 4, __nv_bfloat16>;
    C10_CUDA_CHECK(cudaFuncSetAttribute(kern, cudaFuncAttributeMaxDynamicSharedMemorySize, (int)sh));
    kern<<<dim3(NT, H), 256, sh, st>>>(
        (const __half*)q.data_ptr(), (const __half*)k.data_ptr(), (const __half*)v.data_ptr(),
        (const __half*)h.data_ptr(), g.data_ptr<float>(), (__nv_bfloat16*)o.data_ptr(),
        chunk_indices.data_ptr<int>(), cu_seqlens.data_ptr<int>(), T, H, Hg, (float)scale);
  } else {
    auto kern = fa2_sm70::gdn::volta_gdn_chunk_o<BT, DK, DV, 2, 4, __half>;
    C10_CUDA_CHECK(cudaFuncSetAttribute(kern, cudaFuncAttributeMaxDynamicSharedMemorySize, (int)sh));
    kern<<<dim3(NT, H), 256, sh, st>>>(
        (const __half*)q.data_ptr(), (const __half*)k.data_ptr(), (const __half*)v.data_ptr(),
        (const __half*)h.data_ptr(), g.data_ptr<float>(), (__half*)o.data_ptr(),
        chunk_indices.data_ptr<int>(), cu_seqlens.data_ptr<int>(), T, H, Hg, (float)scale);
  }
  C10_CUDA_KERNEL_LAUNCH_CHECK();
  return o;
}

// ------------------------------------------------------------------------------------------------
// БОЕВАЯ ТОЧКА ВХОДА: весь скан за один вызов. q,k -- УЖЕ fp16 (их пишет l2norm), v и beta -- bf16
// (конвертируются здесь слитым проходом), g -- fp32 (его пишет chunk_local_cumsum).
// ------------------------------------------------------------------------------------------------
std::tuple<torch::Tensor, torch::Tensor> gdn_chunk_scan(
    torch::Tensor q, torch::Tensor k, torch::Tensor v_in, torch::Tensor g, torch::Tensor beta_in,
    c10::optional<torch::Tensor> h0, torch::Tensor cu_seqlens, torch::Tensor chunk_indices,
    torch::Tensor chunk_offsets, double scale, bool out_bf16, bool output_final_state) {
  const c10::cuda::CUDAGuard guard(q.device());
  CHK(q, torch::kHalf, "q"); CHK(k, torch::kHalf, "k"); CHK(g, torch::kFloat, "g");
  TORCH_CHECK(v_in.is_cuda() && v_in.is_contiguous() && beta_in.is_contiguous(),
              "v/beta must be contiguous CUDA");
  const bool cast_in = (v_in.scalar_type() == torch::kBFloat16);
  TORCH_CHECK(cast_in || v_in.scalar_type() == torch::kHalf, "v must be fp16 or bf16");
  TORCH_CHECK(beta_in.scalar_type() == v_in.scalar_type(), "beta must match v dtype");
  TORCH_CHECK(cu_seqlens.scalar_type() == torch::kInt && chunk_indices.scalar_type() == torch::kInt &&
                  chunk_offsets.scalar_type() == torch::kInt,
              "cu_seqlens/chunk_indices/chunk_offsets must be int32");
  const int T = (int)q.size(-3), Hg = (int)q.size(-2), H = (int)v_in.size(-2);
  const int NT = (int)chunk_indices.size(0);
  auto st = at::cuda::getCurrentCUDAStream();

  // ЕСЛИ РАЗВЁРТКА УЖЕ fp16 -- НЕ КОПИРОВАТЬ. Безусловная конверсия "на всякий случай" стоила бы
  // здесь двух лишних проходов по 96 МБ на слой (0.6 мс) РОВНО НИ ЗА ЧТО. Ветка выбирается по
  // фактическому типу тензора, а не по флагу конфигурации.
  torch::Tensor v = v_in, beta = beta_in;
  if (cast_in) {
    v = torch::empty({1, T, H, DV}, torch::dtype(torch::kHalf).device(q.device()));
    beta = torch::empty({1, T, H}, torch::dtype(torch::kHalf).device(q.device()));
    const long nv = (long)T * H * DV, nb = (long)T * H;
    const int thr = 256;
    // Сетка ограничена сверху: ядро памяти-ограничено и от лишних блоков не ускоряется, а
    // хвостовой цикл по beta им бы только раздробился.
    int blocks = (int)((nv / 8 + thr - 1) / thr);
    if (blocks > 4096) blocks = 4096;
    if (blocks < 1) blocks = 1;
    gdn_cast_in<<<blocks, thr, 0, st>>>((const __nv_bfloat16*)v_in.data_ptr(), (__half*)v.data_ptr(),
                                        (const __nv_bfloat16*)beta_in.data_ptr(),
                                        (__half*)beta.data_ptr(), nv, nb);
    C10_CUDA_KERNEL_LAUNCH_CHECK();
  }
  auto A = gdn_kkt(k, beta, g, cu_seqlens, chunk_indices, H);
  auto Ai = gdn_solve_tril(A, cu_seqlens, chunk_indices);
  // ВТОРОЙ СРЕЗ СЛИЯНИЯ: при сшитом wu пуска gdn_wu НЕТ, и плиты w [T,H,DK] и u [T,H,DV] не
  // рождаются -- слитое тело считает их скобку у себя (см. подстановку в volta_gdn_ho.cuh).
  static const bool сшито_wu =
      (getenv("FA2SM70_GDN_WU") == nullptr) || (std::string(getenv("FA2SM70_GDN_WU")) != "0");
  static const bool слитно =
      (getenv("FA2SM70_GDN_HO") == nullptr) || (std::string(getenv("FA2SM70_GDN_HO")) != "0");
  if (слитно && сшито_wu && !out_bf16) {
    auto ho = gdn_ho(q, k, v /*не читается*/, v, g, h0, cu_seqlens, chunk_offsets, NT,
                     scale, output_final_state, false, Ai, beta);
    static long счёт2 = 0;
    if (((++счёт2) & (счёт2 - 1)) == 0)
      fprintf(stderr, "[fa2_sm70 gdn] СШИТОЕ ТЕЛО h+o+wu отработало: вызовов %ld (T=%d, чанков %d)"
                      " -- пусков на слой 3, плиты w/u НЕ РОЖДАЮТСЯ\n", счёт2, T, (int)NT);
    return {std::get<0>(ho), std::get<1>(ho)};
  }
  auto wu = gdn_wu(k, v, beta, g, Ai, cu_seqlens, chunk_indices);
  // output_final_state проброшен, а не зашит в true: финальное состояние -- это N*H*DV*DK fp32,
  // то есть лишняя запись 6.3 МБ на слой там, где вызывающий его не просил. На 48 слоях это
  // 0.3 ГБ за чанк-проход -- мелочь, которую незачем платить, раз флаг и так есть в контракте.
  // СЛИТОЕ ТЕЛО ВМЕСТО ПАРЫ h+o. Плита h [NT,H,DV,DK] и v_new наружу НЕ ИДУТ: выход считается в
  // том же блоке, где лежит состояние. На боевом виде (3136 токенов, 49 чанков, GQA=3, живое
  // начальное состояние) сверено посрезно: полный o -- relL2 1.9e-05, A -- 2.1e-04, ht -- БИТ В БИТ.
  //
  // ОТКАТ ТОЛЬКО ПО ФОРМЕ, не по ресурсу (см. память про тотальный except): слитое тело пишет
  // выход в fp16, поэтому запрос bf16-выхода уходит на прежнюю пару. Гейт -- на случай, если
  // понадобится сравнить пути на живом сервере.
  if (слитно && !out_bf16) {
    auto ho = gdn_ho(q, k, std::get<0>(wu), std::get<1>(wu), g, h0, cu_seqlens, chunk_offsets, NT,
                     scale, output_final_state, false, c10::nullopt, c10::nullopt);
    // СЧЁТЧИК ФАКТИЧЕСКОЙ РАБОТЫ, а не признак наличия: доказывает, что слитый путь ИСПОЛНЯЛСЯ.
    static long счёт = 0;
    if (((++счёт) & (счёт - 1)) == 0)
      fprintf(stderr, "[fa2_sm70 gdn] СЛИТОЕ ТЕЛО h+o отработало: вызовов %ld (T=%d, чанков %d)\n",
              счёт, T, (int)NT);
    return {std::get<0>(ho), std::get<1>(ho)};
  }
  auto hv = gdn_h(k, std::get<0>(wu), std::get<1>(wu), g, h0, cu_seqlens, chunk_offsets, NT,
                  output_final_state);
  auto o = gdn_o(q, k, std::get<1>(hv), std::get<0>(hv), g, cu_seqlens, chunk_indices, scale,
                 out_bf16);
  return {o, std::get<2>(hv)};
}

// ------------------------------------------------------------------------------------------------
// [ЗАДАЧА 180] РЕКУРРЕНТНЫЙ ШАГ ДЕКОДА. Замена fused_recurrent_gated_delta_rule (fla/Triton).
// Контракт повторяет Triton-ядро: состояние fp32 в ПУЛЕ (h0 и ht -- один тензор, inplace),
// начальный слот -- по ssm_state_indices (спекуляция: по num_accepted_tokens-1), запись -- по
// слоту каждого токена; слот < 0 (PAD_SLOT_ID) -- блока/записи нет.
// ------------------------------------------------------------------------------------------------
torch::Tensor gdn_recurrent(torch::Tensor q, torch::Tensor k, torch::Tensor v, torch::Tensor g,
                            torch::Tensor beta, double scale, torch::Tensor hpool,
                            c10::optional<torch::Tensor> ssm_idx,
                            c10::optional<torch::Tensor> n_acc,
                            c10::optional<torch::Tensor> cu_seqlens, bool l2norm) {
  const c10::cuda::CUDAGuard guard(q.device());
  TORCH_CHECK(q.is_cuda() && q.is_contiguous() && k.is_contiguous() && v.is_contiguous(),
              "gdn_recurrent: q/k/v must be contiguous CUDA");
  TORCH_CHECK(q.scalar_type() == torch::kHalf || q.scalar_type() == torch::kBFloat16,
              "gdn_recurrent: q must be fp16/bf16");
  TORCH_CHECK(k.scalar_type() == q.scalar_type() && v.scalar_type() == q.scalar_type() &&
                  beta.scalar_type() == q.scalar_type(),
              "gdn_recurrent: k/v/beta must match q dtype");
  CHK(g, torch::kFloat, "g");
  TORCH_CHECK(hpool.scalar_type() == torch::kFloat && hpool.is_cuda(),
              "gdn_recurrent: state pool must be fp32 CUDA");
  const int B = (int)q.size(0), T = (int)q.size(1), H = (int)q.size(2), Kd = (int)q.size(3);
  const int HV = (int)v.size(2), Vd = (int)v.size(3);
  TORCH_CHECK(Kd == DK && Vd == DK, "gdn_recurrent: written for K=V=128");
  TORCH_CHECK(HV % H == 0, "gdn_recurrent: HV must be a multiple of H");
  // Пул: [slots, HV, V, K] с плотным хвостом; шаг слота -- stride(0) НЕ обязателен плотным
  TORCH_CHECK(hpool.stride(-1) == 1 && hpool.size(-1) == Kd && hpool.size(-2) == Vd &&
                  hpool.size(-3) == HV,
              "gdn_recurrent: pool tail must be [HV, V, K] dense");
  const long stride_slot = (long)hpool.stride(0);
  long stride_idx = 0;
  const bool has_idx = ssm_idx.has_value();
  const bool spec = n_acc.has_value();
  torch::Tensor si;
  if (has_idx) {
    si = ssm_idx.value();
    TORCH_CHECK(si.is_cuda() && si.dim() >= 1 &&
                    (si.scalar_type() == torch::kInt || si.scalar_type() == torch::kLong),
                "gdn_recurrent: ssm_state_indices must be int32/int64");
    stride_idx = (long)si.stride(0);
  }
  // ширина ряда таблицы слотов -- предел чтения по токенам (см. volta_gdn_rec.cuh)
  const int idx_w_r = has_idx ? (si.dim() >= 2 ? (int)si.size(si.dim() - 1) : 1) : 0;
  torch::Tensor cu;
  const bool varlen = cu_seqlens.has_value();
  if (varlen) {
    cu = cu_seqlens.value();
    TORCH_CHECK(cu.scalar_type() == torch::kInt || cu.scalar_type() == torch::kLong,
                "gdn_recurrent: cu_seqlens must be int32/int64");
    TORCH_CHECK(!has_idx || cu.scalar_type() == si.scalar_type(),
                "gdn_recurrent: cu_seqlens and ssm_state_indices must share the int type");
  }
  const int N = varlen ? (int)cu.size(0) - 1 : B;
  auto o = torch::empty_like(v);
  auto st = at::cuda::getCurrentCUDAStream();
  constexpr int BV = 32;
  dim3 grid(DK / BV, HV, N);

  auto go = [&](auto ti_tag, auto idx_tag, auto l2_tag, auto sp_tag) {
    using TI = typename decltype(ti_tag)::type;
    using IdxT = typename decltype(idx_tag)::type;
    constexpr bool L2N = decltype(l2_tag)::value;
    constexpr bool SPEC = decltype(sp_tag)::value;
    auto kern = fa2_sm70::gdn::volta_gdn_rec<DK, DK, BV, L2N, SPEC, TI, IdxT>;
    kern<<<grid, 128, 0, st>>>(
        (const TI*)q.data_ptr(), (const TI*)k.data_ptr(), (const TI*)v.data_ptr(),
        g.data_ptr<float>(), (const TI*)beta.data_ptr(), (TI*)o.data_ptr(),
        hpool.data_ptr<float>(),
        has_idx ? (const IdxT*)si.data_ptr() : nullptr,
        spec ? n_acc.value().data_ptr<int>() : nullptr,
        varlen ? (const IdxT*)cu.data_ptr() : nullptr,
        stride_idx, stride_slot, (float)scale, T, H, HV,
        // у ядра CUDA умолчания при запуске <<<>>> НЕ действуют -- перечисляем все:
        // a_in, A_log, dt_bias (GATE=0 их не читает), ssm_idx_out (этот путь без 'all')
        // и ШИРИНУ РЯДА таблицы слотов.
        nullptr, nullptr, nullptr, nullptr, nullptr, idx_w_r, /*branch_at=*/0);
  };
  struct TagH { using type = __half; };
  struct TagB { using type = __nv_bfloat16; };
  struct TagI { using type = int; };
  struct TagL { using type = long; };
  const bool is_half = q.scalar_type() == torch::kHalf;
  const bool idx_long = (has_idx && si.scalar_type() == torch::kLong) ||
                        (!has_idx && varlen && cu.scalar_type() == torch::kLong);
  auto d3 = [&](auto ti, auto ix) {
    if (l2norm) {
      if (spec) go(ti, ix, std::true_type{}, std::true_type{});
      else go(ti, ix, std::true_type{}, std::false_type{});
    } else {
      if (spec) go(ti, ix, std::false_type{}, std::true_type{});
      else go(ti, ix, std::false_type{}, std::false_type{});
    }
  };
  if (is_half) { if (idx_long) d3(TagH{}, TagL{}); else d3(TagH{}, TagI{}); }
  else         { if (idx_long) d3(TagB{}, TagL{}); else d3(TagB{}, TagI{}); }
  C10_CUDA_KERNEL_LAUNCH_CHECK();
  return o;
}

// [ЗАДАЧА 180, боевой быстрый путь] СЛИТЫЙ сигмоидный гейтинг + рекуррент: замена
// fused_sigmoid_gating_delta_rule_update (ровно её и зовёт _forward_core декода qwen3_next).
// g и beta считаются В ЯДРЕ из a, b, A_log, dt_bias -- отдельного гейтинг-пуска нет.
torch::Tensor gdn_rec_gating(torch::Tensor A_log, torch::Tensor a, torch::Tensor b,
                             torch::Tensor dt_bias, torch::Tensor q, torch::Tensor k,
                             torch::Tensor v, double scale, torch::Tensor hpool,
                             c10::optional<torch::Tensor> ssm_idx,
                             c10::optional<torch::Tensor> n_acc,
                             c10::optional<torch::Tensor> cu_seqlens, bool l2norm,
                             c10::optional<torch::Tensor> ssm_idx_out,
                             c10::optional<torch::Tensor> state_scales,
                             int64_t branch_at) {
  const c10::cuda::CUDAGuard guard(q.device());
  TORCH_CHECK(q.is_cuda() && q.is_contiguous() && k.is_contiguous() && v.is_contiguous() &&
                  a.is_contiguous() && b.is_contiguous(),
              "gdn_rec_gating: q/k/v/a/b must be contiguous CUDA");
  TORCH_CHECK(q.scalar_type() == torch::kHalf || q.scalar_type() == torch::kBFloat16,
              "gdn_rec_gating: q must be fp16/bf16");
  TORCH_CHECK(k.scalar_type() == q.scalar_type() && v.scalar_type() == q.scalar_type() &&
                  a.scalar_type() == q.scalar_type() && b.scalar_type() == q.scalar_type(),
              "gdn_rec_gating: k/v/a/b must match q dtype");
  CHK(A_log, torch::kFloat, "A_log"); CHK(dt_bias, torch::kFloat, "dt_bias");
  // Пул состояний: fp32 ИЛИ fp16. Половинная точность здесь -- не «экономия ради экономии»:
  // в режиме префикс-кэша состояние лежит на КАЖДОЙ границе блока, и его формат прямо задаёт
  // ёмкость контекста. Читаем/пишем ВНУТРИ ядра (StateT), чтобы не платить конверсией на шве.
  // ФОРМАТЫ СОСТОЯНИЯ: fp32 | fp16 | int16 с масштабом. Последний -- ход 20.08: те же два
  // байта, но равномерная сетка; fp16 доказанно вырождает длинную генерацию (повторы 0.94
  // против 0.00 у fp32 на одном промпте), а ёмкость терять нельзя.
  TORCH_CHECK(hpool.is_cuda() && (hpool.scalar_type() == torch::kFloat ||
                                  hpool.scalar_type() == torch::kHalf ||
                                  hpool.scalar_type() == torch::kShort),
              "gdn_rec_gating: state pool must be fp32/fp16/int16 CUDA");
  const bool state_half = hpool.scalar_type() == torch::kHalf;
  const bool state_i16 = hpool.scalar_type() == torch::kShort;
  float* p_scl = nullptr;
  if (state_i16) {
    TORCH_CHECK(state_scales.has_value(),
                "gdn_rec_gating: int16-состояние требует таблицу масштабов");
    auto sc_t = state_scales.value();
    TORCH_CHECK(sc_t.is_cuda() && sc_t.scalar_type() == torch::kFloat && sc_t.is_contiguous(),
                "gdn_rec_gating: масштабы состояния -- fp32 CUDA contiguous");
    p_scl = sc_t.data_ptr<float>();
  }
  const int B = (int)q.size(0), T = (int)q.size(1), H = (int)q.size(2), Kd = (int)q.size(3);
  const int HV = (int)v.size(2), Vd = (int)v.size(3);
  TORCH_CHECK(Kd == DK && Vd == DK, "gdn_rec_gating: written for K=V=128");
  TORCH_CHECK(HV % H == 0 && (int)A_log.numel() == HV && (int)dt_bias.numel() == HV,
              "gdn_rec_gating: head shapes");
  TORCH_CHECK(hpool.stride(-1) == 1 && hpool.size(-1) == Kd && hpool.size(-2) == Vd &&
                  hpool.size(-3) == HV,
              "gdn_rec_gating: pool tail must be [HV, V, K] dense");
  const long stride_slot = (long)hpool.stride(0);
  long stride_idx = 0;
  const bool has_idx = ssm_idx.has_value();
  const bool spec = n_acc.has_value();
  torch::Tensor si;
  if (has_idx) {
    si = ssm_idx.value();
    TORCH_CHECK(si.is_cuda() && si.dim() >= 1 &&
                    (si.scalar_type() == torch::kInt || si.scalar_type() == torch::kLong),
                "gdn_rec_gating: ssm_state_indices must be int32/int64");
    stride_idx = (long)si.stride(0);
  }
  torch::Tensor sio;
  const bool has_idx_out = ssm_idx_out.has_value();
  if (has_idx_out) {
    sio = ssm_idx_out.value();
    TORCH_CHECK(sio.is_cuda() && sio.dim() == 1 && sio.is_contiguous(),
                "gdn_rec_gating: ssm_state_indices_out must be 1-D contiguous CUDA");
    TORCH_CHECK(!has_idx || sio.scalar_type() == si.scalar_type(),
                "gdn_rec_gating: index tensors must share the int type");
  }
  // ШИРИНА РЯДА ТАБЛИЦЫ (закрыто 20.08, найдено гейтом + memcheck). Ядро при нескольких
  // токенах на последовательность адресует ssm_idx[i_n*stride_idx + it] на КАЖДЫЙ токен.
  // Если ряд короче числа токенов (например [N,1] при 4 токенах), оно читало СОСЕДНИЙ ряд,
  // а на последней последовательности -- за конец тензора, и писало состояние ПО ЧУЖОМУ
  // ИНДЕКСУ: illegal access всплывал на ДРУГОМ вызове, а при удачной раскладке порча шла
  // молча. Предел передаётся в ядро: за пределом ряда состояние просто не пишется -- как
  // и при PAD_SLOT_ID. Боевые пути ширину соблюдают (декод 1 токен; спекуляция даёт ряд
  // num_spec+1; режим 'all' идёт через ssm_idx_out), предел им ничего не меняет.
  const int idx_w = has_idx ? (si.dim() >= 2 ? (int)si.size(si.dim() - 1) : 1) : 0;
  torch::Tensor cu;
  const bool varlen = cu_seqlens.has_value();
  if (varlen) {
    cu = cu_seqlens.value();
    TORCH_CHECK(cu.scalar_type() == torch::kInt || cu.scalar_type() == torch::kLong,
                "gdn_rec_gating: cu_seqlens must be int32/int64");
    TORCH_CHECK(!has_idx || cu.scalar_type() == si.scalar_type(),
                "gdn_rec_gating: cu_seqlens and ssm_state_indices must share the int type");
  }
  const int N = varlen ? (int)cu.size(0) - 1 : B;
  auto o = torch::empty_like(v);
  auto st = at::cuda::getCurrentCUDAStream();
  constexpr int BV = 32;
  dim3 grid(DK / BV, HV, N);
  auto go = [&](auto ti_tag, auto idx_tag, auto l2_tag, auto sp_tag) {
    using TI = typename decltype(ti_tag)::type;
    using IdxT = typename decltype(idx_tag)::type;
    constexpr bool L2N = decltype(l2_tag)::value;
    constexpr bool SPEC = decltype(sp_tag)::value;
    if (state_i16) {
      auto kern_i = fa2_sm70::gdn::volta_gdn_rec<DK, DK, BV, L2N, SPEC, TI, IdxT, 1, short>;
      kern_i<<<grid, 128, 0, st>>>(
          (const TI*)q.data_ptr(), (const TI*)k.data_ptr(), (const TI*)v.data_ptr(),
          nullptr, (const TI*)b.data_ptr(), (TI*)o.data_ptr(),
          (short*)hpool.data_ptr(),
          has_idx ? (const IdxT*)si.data_ptr() : nullptr,
          spec ? n_acc.value().data_ptr<int>() : nullptr,
          varlen ? (const IdxT*)cu.data_ptr() : nullptr,
          stride_idx, stride_slot, (float)scale, T, H, HV,
          (const TI*)a.data_ptr(), A_log.data_ptr<float>(), dt_bias.data_ptr<float>(),
          has_idx_out ? (const IdxT*)sio.data_ptr() : nullptr, p_scl, idx_w, (int)branch_at);
      return;
    }
    if (state_half) {
      auto kern_h = fa2_sm70::gdn::volta_gdn_rec<DK, DK, BV, L2N, SPEC, TI, IdxT, 1, __half>;
      kern_h<<<grid, 128, 0, st>>>(
          (const TI*)q.data_ptr(), (const TI*)k.data_ptr(), (const TI*)v.data_ptr(),
          nullptr, (const TI*)b.data_ptr(), (TI*)o.data_ptr(),
          (__half*)hpool.data_ptr(),
          has_idx ? (const IdxT*)si.data_ptr() : nullptr,
          spec ? n_acc.value().data_ptr<int>() : nullptr,
          varlen ? (const IdxT*)cu.data_ptr() : nullptr,
          stride_idx, stride_slot, (float)scale, T, H, HV,
          (const TI*)a.data_ptr(), A_log.data_ptr<float>(), dt_bias.data_ptr<float>(),
          has_idx_out ? (const IdxT*)sio.data_ptr() : nullptr, nullptr, idx_w, (int)branch_at);
      return;
    }
    auto kern = fa2_sm70::gdn::volta_gdn_rec<DK, DK, BV, L2N, SPEC, TI, IdxT, 1>;
    kern<<<grid, 128, 0, st>>>(
        (const TI*)q.data_ptr(), (const TI*)k.data_ptr(), (const TI*)v.data_ptr(),
        nullptr, (const TI*)b.data_ptr(), (TI*)o.data_ptr(),
        hpool.data_ptr<float>(),
        has_idx ? (const IdxT*)si.data_ptr() : nullptr,
        spec ? n_acc.value().data_ptr<int>() : nullptr,
        varlen ? (const IdxT*)cu.data_ptr() : nullptr,
        stride_idx, stride_slot, (float)scale, T, H, HV,
        (const TI*)a.data_ptr(), A_log.data_ptr<float>(), dt_bias.data_ptr<float>(),
        has_idx_out ? (const IdxT*)sio.data_ptr() : nullptr, nullptr, idx_w, (int)branch_at);
  };
  struct TagH { using type = __half; };
  struct TagB { using type = __nv_bfloat16; };
  struct TagI { using type = int; };
  struct TagL { using type = long; };
  const bool is_half = q.scalar_type() == torch::kHalf;
  const bool idx_long = (has_idx && si.scalar_type() == torch::kLong) ||
                        (!has_idx && varlen && cu.scalar_type() == torch::kLong);
  auto d3 = [&](auto ti, auto ix) {
    if (l2norm) {
      if (spec) go(ti, ix, std::true_type{}, std::true_type{});
      else go(ti, ix, std::true_type{}, std::false_type{});
    } else {
      if (spec) go(ti, ix, std::false_type{}, std::true_type{});
      else go(ti, ix, std::false_type{}, std::false_type{});
    }
  };
  if (is_half) { if (idx_long) d3(TagH{}, TagL{}); else d3(TagH{}, TagI{}); }
  else         { if (idx_long) d3(TagB{}, TagL{}); else d3(TagB{}, TagI{}); }
  C10_CUDA_KERNEL_LAUNCH_CHECK();
  return o;
}

// Явный признак присутствия: гейт врезки проверяет ИМЕННО его, а не факт импорта модуля.
int64_t gdn_scan_available() { return 1; }

}  // namespace

// ---------------------------------------------------------------------------------------------
// КВАНТОВАНИЕ СОСТОЯНИЯ GDN В int16 -- ОДНИМ ЯДРОМ ВМЕСТО СЕМИ ЗАПУСКОВ ИЗ ПИТОНА.
//
// ЗАЧЕМ. `fa2sm70_gdn_i16.квант` строит масштабы и квант тензора цепочкой торч-операций:
// .float() -> reshape -> abs -> amax -> amax -> where -> деление -> round -> .to(int16).
// Это семь запусков ядер и ощутимая доля питона в пути: py-spy на воркере под нагрузкой дал
// 1.18 % снимков на строке `q, s = квант(значение)` плюс ещё ~0.4 % на его частях.
//
// РАСКЛАДКА МАСШТАБОВ ПОВТОРЯЕТ ВЛАДЕНИЕ В `volta_gdn_rec`: варп w держит строки vrow = w + 4j,
// срез -- BV=32 строк, поэтому масштаб живёт на (слот, голова, срез, варп). Здесь ровно то же:
// блок = один (слот, голова, срез), варп w сворачивает СВОИ BV/WARPS строк по всем столбцам.
// Редукция чисто варповая -- пять shfl, ни одного барьера.
//
// ОКРУГЛЕНИЕ -- `rintf`, а не `roundf`: `torch.round` округляет половину К ЧЁТНОМУ, и `roundf`
// (половина ОТ НУЛЯ) разошёлся бы с питоном на значениях вида x.5. Гейт сверяет побитово,
// поэтому такая мелочь видна сразу.
template <typename T>
__global__ void gdn_state_quant_kernel(const T* __restrict__ x, int16_t* __restrict__ q,
                                       float* __restrict__ s, int D1, int D2, float QMAX) {
  constexpr int BV = 32, WARPS = 4, ROWS = BV / WARPS;   // 8 строк на варп
  const int срез_всего = D1 / BV;
  const int блок = blockIdx.x;                            // (слот*HV + голова)*срезов + срез
  const int срез = блок % срез_всего;
  const long база = (long)(блок / срез_всего) * D1 * D2 + (long)срез * BV * D2;
  const int warp = threadIdx.x >> 5, lane = threadIdx.x & 31;

  float m = 0.f;
  for (int j = 0; j < ROWS; ++j) {
    const long стр = база + (long)(warp + WARPS * j) * D2;
    for (int c = lane; c < D2; c += 32) {
      const float v = fabsf((float)x[стр + c]);
      m = fmaxf(m, v);
    }
  }
  #pragma unroll
  for (int off = 16; off > 0; off >>= 1) m = fmaxf(m, __shfl_xor_sync(0xffffffffu, m, off));
  const float sc = (m > 0.f) ? (m / QMAX) : 1.f;
  if (lane == 0) s[(long)блок * WARPS + warp] = sc;

  // ДЕЛЕНИЕ ТОЧНОЕ, ЧЕРЕЗ `__fdiv_rn`. Три ловушки подряд, каждую поймал побитовый гейт:
  //   1) `x * (1/s)` расходится с питоновским `x / s` в последнем бите -- 80 значений из
  //      524288, каждое на ЕДИНИЦУ (округление половины к чётному делает это видимым);
  //   2) обычное `/` НЕ спасает: единица трансляции собрана с `--use_fast_math`, а он
  //      подразумевает `-prec-div=false`, то есть то же приближённое деление;
  //   3) `__fdividef` -- тем более приближённое.
  // `__fdiv_rn` даёт ровно IEEE-деление с округлением к ближайшему, как у торча.
  for (int j = 0; j < ROWS; ++j) {
    const long стр = база + (long)(warp + WARPS * j) * D2;
    for (int c = lane; c < D2; c += 32) {
      q[стр + c] = (int16_t)rintf(__fdiv_rn((float)x[стр + c], sc));
    }
  }
}

void gdn_state_quant(at::Tensor x, at::Tensor q, at::Tensor s, double qmax) {
  TORCH_CHECK(x.is_cuda() && q.is_cuda() && s.is_cuda(), "gdn_state_quant: нужны тензоры на карте");
  TORCH_CHECK(x.dim() >= 3, "gdn_state_quant: ожидаю [..., HV, D1, D2]");
  TORCH_CHECK(q.scalar_type() == at::kShort, "gdn_state_quant: выход обязан быть int16");
  TORCH_CHECK(s.scalar_type() == at::kFloat, "gdn_state_quant: масштабы обязаны быть float32");
  TORCH_CHECK(x.is_contiguous() && q.is_contiguous(), "gdn_state_quant: нужен плотный шаг");
  const int D2 = (int)x.size(-1), D1 = (int)x.size(-2);
  TORCH_CHECK(D1 % 32 == 0, "gdn_state_quant: предпоследняя ось не кратна срезу 32");
  const long групп = x.numel() / ((long)D1 * D2) * (D1 / 32);
  TORCH_CHECK(s.numel() == групп * 4, "gdn_state_quant: таблица масштабов не той формы");
  auto поток = at::cuda::getCurrentCUDAStream();
  if (x.scalar_type() == at::kFloat) {
    gdn_state_quant_kernel<float><<<(int)групп, 128, 0, поток>>>(
        x.data_ptr<float>(), q.data_ptr<int16_t>(), s.data_ptr<float>(), D1, D2, (float)qmax);
  } else if (x.scalar_type() == at::kHalf) {
    gdn_state_quant_kernel<at::Half><<<(int)групп, 128, 0, поток>>>(
        x.data_ptr<at::Half>(), q.data_ptr<int16_t>(), s.data_ptr<float>(), D1, D2, (float)qmax);
  } else {
    TORCH_CHECK(false, "gdn_state_quant: поддержаны float32 и float16");
  }
}


PYBIND11_MODULE(TORCH_EXTENSION_NAME, m) {
  m.def("gdn_chunk_scan", &gdn_chunk_scan,
        "gated-delta-net chunk scan on Volta tensor cores (whole chain, sm_70)",
        pybind11::arg("q"), pybind11::arg("k"), pybind11::arg("v"), pybind11::arg("g"),
        pybind11::arg("beta"), pybind11::arg("initial_state"), pybind11::arg("cu_seqlens"),
        pybind11::arg("chunk_indices"), pybind11::arg("chunk_offsets"), pybind11::arg("scale"),
        pybind11::arg("out_bf16"), pybind11::arg("output_final_state") = true);
  m.def("gdn_kkt", &gdn_kkt, "beta*K*K^T внутри чанка (замена chunk_scaled_dot_kkt_fwd)");
  m.def("gdn_solve_tril", &gdn_solve_tril, "(I+A)^{-1} по чанкам (замена solve_tril)");
  m.def("gdn_wu", &gdn_wu, "w,u чанкового представления WY (замена recompute_w_u_fwd)");
  m.def("gdn_h", &gdn_h, "межчанковое состояние + v_new (замена chunk_gated_delta_rule_fwd_h)");
  m.def("gdn_ho", &gdn_ho, "СЛИТОЕ: рекуррентность + выход, без плиты h (с Ai/beta -- ещё и без w/u)",
        pybind11::arg("q"), pybind11::arg("k"), pybind11::arg("w"), pybind11::arg("u"),
        pybind11::arg("g"), pybind11::arg("initial_state"), pybind11::arg("cu_seqlens"),
        pybind11::arg("chunk_offsets"), pybind11::arg("NT"), pybind11::arg("scale"),
        pybind11::arg("output_final_state"), pybind11::arg("dump_A"),
        pybind11::arg("Ai") = c10::nullopt, pybind11::arg("beta") = c10::nullopt);
  m.def("gdn_o", &gdn_o, "выход скана (замена chunk_fwd_o)");
  m.def("gdn_scan_available", &gdn_scan_available, "признак присутствия для гейта врезки");
  m.def("gdn_recurrent", &gdn_recurrent,
        "рекуррентный шаг декода (замена fused_recurrent_gated_delta_rule), состояние inplace");
  m.def("gdn_rec_gating", &gdn_rec_gating,
        "СЛИТЫЙ сигмоидный гейтинг + рекуррент (замена fused_sigmoid_gating_delta_rule_update)");
  m.def("gdn_state_quant", &gdn_state_quant,
        "квантование состояния GDN в int16 с масштабами по (слот, голова, срез, варп)",
        pybind11::arg("x"), pybind11::arg("q"), pybind11::arg("s"), pybind11::arg("qmax"));
}
